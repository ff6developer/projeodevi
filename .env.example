# Bu projenin çalışması için gereken ortam değişkenleri.
# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Vercel'de: Project Settings > Environment Variables içinde aynı isimlerle ekleyin.

# Sitenin gerçek production alan adı. metadataBase, sitemap.xml ve robots.txt
# içindeki mutlak URL'ler için kullanılır. Ayarlanmazsa https://example.com
# yer tutucusu kullanılır (bu placeholder canlıda SEO'yu bozar, mutlaka ayarlayın).
NEXT_PUBLIC_SITE_URL=https://sizin-domaininiz.com

# /backend klasöründeki Express API'si artık Vercel Services ile bu Next.js
# uygulamasıyla AYNI Vercel projesinde deploy ediliyor (bkz. kök dizindeki
# vercel.json). Backend'e aynı domain üzerinden /api/backend/* altından
# erişilir; ayrı bir backend URL'i GEREKMEZ.
#
# Production (Vercel): Bu değişkeni BOŞ BIRAKIN — Vercel proje ayarlarında
# NEXT_PUBLIC_API_URL adıyla ekleyin ama değerini boş bırakın (empty string).
# Böylece istekler aynı origin'den /api/backend/... olarak gider.
# Yerel geliştirme: Bu satırı silin/yorumda bırakın (undefined kalsın) —
# o zaman kod otomatik olarak http://localhost:5000'e düşer ve
# "node backend/index.js" ile ayrıca çalıştırdığınız backend'e bağlanır.
NEXT_PUBLIC_API_URL=
