# Ortam değişkenleri. Yerelde: bu dosyayı .env.local olarak kopyalayın.
# Vercel'de: Project Settings > Environment Variables.

# Sitenin production alan adı. metadataBase, sitemap.xml ve robots.txt için
# kullanılır. Ayarlanmazsa https://example.com yer tutucusu kullanılır
# (bu placeholder canlıda SEO'yu bozar — mutlaka ayarlayın).
NEXT_PUBLIC_SITE_URL=https://elmenescoffee.com

# /backend (Express) aynı Vercel projesinde, aynı domainde deploy edilir
# (bkz. vercel.json). Production'da BOŞ bırakın — istekler aynı origin'den
# /api/backend/... olarak gider. Yerelde bu satırı silin/yorumda bırakın:
# kod otomatik olarak http://localhost:5000'e düşer.
NEXT_PUBLIC_API_URL=
