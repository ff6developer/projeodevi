# Elmenes Coffee — ortam değişkenleri (hepsi opsiyonel)
#
# Bu proje client-side bir prototiptir: backend, database, gerçek ödeme YOKTUR.
# Aşağıdaki değişkenler yalnızca meta/SEO içindir.

# Kanonik site adresi (canonical, Open Graph, sitemap, robots).
# Ayarlanmazsa Vercel otomatik production domain'i, o da yoksa localhost kullanılır.
# NEXT_PUBLIC_SITE_URL=https://elmenes-coffee.vercel.app

# Local adapter'ların yapay ağ gecikmesini kapat (test/hız için).
# NEXT_PUBLIC_MOCK_LATENCY=0
